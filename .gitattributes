# Text normalization
* text=auto

# Source and certificate files are normalized to LF for stable hashes/diffs.
*.bib text eol=lf
*.cff text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.sha256 text eol=lf
*.tex text eol=lf
*.txt text eol=lf

# Generated binary artifacts.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
